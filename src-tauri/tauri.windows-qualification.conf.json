{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "features": []
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "../installer/nsis/installer.nsi",
        "installerHooks": "../installer/nsis/lifetime.nsh"
      }
    }
  }
}
