{
  "name": "image-ranker",
  "private": true,
  "description": "Local Windows image comparison, ranking and organization",
  "license": "MIT",
  "author": "eriklgamedev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eriklgamedev/image-ranker.git"
  },
  "homepage": "https://github.com/eriklgamedev/image-ranker#readme",
  "bugs": {
    "url": "https://github.com/eriklgamedev/image-ranker/issues"
  },
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "check": "npm run typecheck && npm test && npm run build",
    "build:e2e": "tsc --noEmit && vite build --mode e2e",
    "desktop:build:e2e": "tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json && node tests/desktop/capture-build.mjs",
    "test:desktop": "wdio run wdio.conf.mjs",
    "notices:generate": "node scripts/generate-notices.mjs",
    "notices:check": "node scripts/generate-notices.mjs --check"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.13",
    "@tauri-apps/api": "2.12.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.4.0",
    "@wdio/tauri-service": "1.4.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "quickjs-wasi": "2.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "webdriverio": "9.32.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "serialize-javascript": "7.1.2",
    "@puppeteer/browsers": "3.2.3"
  }
}
